MODELS/PERSON.JS

mport mongoose from 'mongoose'

// Määritellään schema henkilölle
const personSchema = new mongoose.Schema({
  name: {
    type: String,
    required: true,      // Pakollinen kenttä
    minlength: 3         // Nimen on oltava vähintään 3 merkkiä
  },
  number: {
    type: String,
    required: true,      // Pakollinen kenttä
    minlength: 8,        // Numero vähintään 8 merkkiä
    // Regex-varmistus, että numero on muodossa xx-xxxxxxx tai xxx-xxxxxxx...
    match: [/^\d{2,3}-\d{5,}$/, 
      'Number must be in correct format (e.g., 09-1234567 or 040-12345678)']
  }
})

// Muutetaan JSON niin, että _id -> id ja poistetaa
personSchema.set('toJSON', {
  transform: (document, returnedObject) => {
    returnedObject.id = returnedObject._id.toString()
    delete returnedObject._id
    delete returnedObject.__v
  }
})

// Exportataan malli
export default mongoose.model('Person', personSchema)



BACKEND



import express from 'express'
import mongoose from 'mongoose'
import morgan from 'morgan'
import cors from 'cors'
import dotenv from 'dotenv'
import Person from './models/person.js'

dotenv.config()

const app = express()

//Middlewaret
app.use(cors())                
app.use(express.json())        
app.use(express.static('build'))

// Morgan näyttää HTTP-pyynnöt konsolissa
morgan.token('body', (req) =>
  req.method === 'POST' || req.method === 'PUT' ? JSON.stringify(req.body) : ''
)
app.use(
  morgan(':method :url :status :res[content-length] - :response-time ms :body')
)

//Mongoose
mongoose
  .connect(process.env.DB_URI) // Yhdistä tietokantaan
  .then(() => console.log('Connected to MongoDB'))
  .catch((err) => console.error('Error connecting to MongoDB:', err.message))

//Routet

// Hae kaikki henkilöt
app.get('/api/persons', (req, res, next) => {
  Person.find({})
    .then((persons) => res.json(persons))
    .catch((err) => next(err))
})

// Haetaan yksi henkilö
app.get('/api/persons/:id', (req, res, next) => {
  Person.findById(req.params.id)
    .then((person) => {
      if (!person) return res.status(404).json({ error: 'Person not found' })
      return res.json(person)
    })
    .catch((err) => next(err))
})

// Info
app.get('/info', (req, res, next) => {
  Person.countDocuments({})
    .then((count) => {
      const date = new Date()
      res.send(`<p>Phonebook has info for ${count} people</p><p>${date}</p>`)
    })
    .catch((err) => next(err))
})

// Uusi henkilö
app.post('/api/persons', (req, res, next) => {
  const person = new Person(req.body) // luo Mongoose-malli

  person
    .save() // tallentaa tietokantaan
    .then((savedPerson) => res.status(201).json(savedPerson))
    .catch((err) => next(err)) // virheet käsitellään errorHandlerissa
})

// Päivietään olemassa olevan henkilön numero
app.put('/api/persons/:id', (req, res, next) => {
  const { number } = req.body

  Person.findByIdAndUpdate(
    req.params.id,
    { number },
    { new: true, runValidators: true, context: 'query' } // runValidators -> Mongoose validointi
  )
    .then((updatedPerson) => {
      if (!updatedPerson) return res.status(404).json({ error: 'Person not found' })
      return res.json(updatedPerson)
    })
    .catch((err) => next(err))
})

// Henkilön poisto
app.delete('/api/persons/:id', (req, res, next) => {
  Person.findByIdAndRemove(req.params.id)
    .then(() => res.status(204).end())
    .catch((err) => next(err))
})

/Virheiden käsittely

// Tuntematon endpoint
const unknownEndpoint = (req, res) => {
  res.status(404).json({ error: 'Unknown endpoint' })
}

// Keskitetty virheenkäsittely
const errorHandler = (error, req, res, next) => {
  console.error(error.message)

  if (error.name === 'CastError') {
    return res.status(400).json({ error: 'Malformatted id' })
  }

  if (error.name === 'ValidationError') {
    return res.status(400).json({ error: error.message })
  }

  next(error)
}

app.use(unknownEndpoint)
app.use(errorHandler)

// Portti
const PORT = process.env.PORT || 3001
app.listen(PORT, () => console.log(`Server running on port ${PORT}`))



NOTIFICATION.JS


const Notification = ({ notification }) => {
  if (!notification) return null  // Ei näytetä mitään jos ei viestiä

  const style = {
    color: notification.type === 'error' ? 'red' : 'green', // Väri virheelle tai onnistumiselle
    background: 'lightgrey',
    fontSize: 20,
    borderStyle: 'solid',
    borderRadius: 5,
    padding: 10,
    marginBottom: 10,
  }

  return <div style={style}>{notification.text}</div>
}

export default Notification


FRONTEND


import { useState, useEffect } from 'react'
import personService from './services/persons'
import Notification from './components/Notification'

const App = () => {
  const [persons, setPersons] = useState([])          // Lista henkilöistä
  const [newName, setNewName] = useState('')          // Lomakkeen nimi
  const [newNumber, setNewNumber] = useState('')      // Lomakkeen numero
  const [notification, setNotification] = useState(null) // Virhe/success

  // Hae henkilöt tietokannasta komponentin alussa
  useEffect(() => {
    personService.getAll().then((initialPersons) => {
      setPersons(initialPersons)
    })
  }, [])

  // Lisää tai päivitä henkilö
  const addPerson = (event) => {
    event.preventDefault()
    const existingPerson = persons.find((p) => p.name === newName)

    if (existingPerson) {
      // Jos henkilö on jo olemassa -> päivitä numero
      if (window.confirm(`${newName} is already added. Replace the number?`)) {
        const updatedPerson = { ...existingPerson, number: newNumber }
        personService
          .update(existingPerson.id, updatedPerson)
          .then((returnedPerson) => {
            // Päivitä tila frontendissä
            setPersons(
              persons.map((p) => (p.id !== existingPerson.id ? p : returnedPerson))
            )
            setNotification({ text: `Updated ${returnedPerson.name}`, type: 'success' })
            setTimeout(() => setNotification(null), 5000)
          })
          .catch((error) => {
            // Näytä virheilmoitus Notification-komponentissa
            setNotification({ text: error.response.data.error, type: 'error' })
            setTimeout(() => setNotification(null), 5000)
          })
      }
    } else {
      // Lisää uusi henkilö
      const personObject = { name: newName, number: newNumber }
      personService
        .create(personObject)
        .then((returnedPerson) => {
          setPersons(persons.concat(returnedPerson))
          setNewName('')
          setNewNumber('')
          setNotification({ text: `Added ${returnedPerson.name}`, type: 'success' })
          setTimeout(() => setNotification(null), 5000)
        })
        .catch((error) => {
          setNotification({ text: error.response.data.error, type: 'error' })
          setTimeout(() => setNotification(null), 5000)
        })
    }
  }

  return (
    <div>
      <h2>Phonebook</h2>
      <Notification notification={notification} />

      <form onSubmit={addPerson}>
        <div>
          name: <input value={newName} onChange={(e) => setNewName(e.target.value)} />
        </div>
        <div>
          number:{' '}
          <input value={newNumber} onChange={(e) => setNewNumber(e.target.value)} />
        </div>
        <div>
          <button type="submit">add</button>
        </div>
      </form>

      <h3>Numbers</h3>
      <ul>
        {persons.map((person) => (
          <li key={person.id}>
            {person.name} {person.number}
            <button
              onClick={() => {
                if (window.confirm(`Delete ${person.name}?`)) {
                  personService
                    .remove(person.id)
                    .then(() => setPersons(persons.filter((p) => p.id !== person.id)))
                    .catch((error) => {
                      setNotification({
                        text: `Information of ${person.name} has already been removed`,
                        type: 'error',
                      })
                      setPersons(persons.filter((p) => p.id !== person.id))
                      setTimeout(() => setNotification(null), 5000)
                    })
                }
              }}
            >
              delete
            </button>
          </li>
        ))}
      </ul>
    </div>
  )
}

export default App



